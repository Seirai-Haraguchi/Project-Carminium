{
  "name": "carminium",
  "version": "0.4.1",
  "description": "Carminium — 本地音乐播放器 (Electron)",
  "main": "electron/main.js",
  "author": "Project Carminium",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start-electron.js .",
    "dev": "node scripts/start-electron.js . --dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:native": "cd native && zig build copy -Doptimize=ReleaseFast",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "gsap": "3.15.0",
    "koffi": "^3.1.2",
    "music-metadata": "^10.0.0",
    "pinyin-pro": "^3.0.0",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "ProjectCarminium.Player",
    "productName": "Project Carminium",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "build/icon.png",
      "version.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "electron/bin/**/*"
    ]
  }
}
