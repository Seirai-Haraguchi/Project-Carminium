{
  "name": "Carminium",
  "version": "0.5.71",
  "description": "Carminium",
  "main": "electron/main.js",
  "author": "Seirai Haraguchi",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "node scripts/start-electron.js .",
    "dev": "node scripts/start-electron.js . --dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "install:win": "npm install && npm run rebuild",
    "install:linux": "npm install && npm run rebuild",
    "build:native": "cd native && zig build copy -Doptimize=ReleaseFast",
    "build:native:linux": "cd native && zig build copy -Doptimize=ReleaseFast -Dtarget=x86_64-linux-gnu",
    "build:native:all": "npm run build:native && npm run build:native:linux",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable",
    "build:all": "npm run build:native && npm run rebuild && npm run build",
    "build:linux": "electron-builder --linux",
    "build:linux-deb": "electron-builder --linux deb",
    "build:linux-portable": "electron-builder --linux AppImage",
    "build:linux-all": "electron-builder --linux deb AppImage",
    "build:cross-win-linux": "electron-builder --win portable --linux deb AppImage"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "gsap": "3.15.0",
    "koffi": "^3.1.4",
    "music-metadata": "^11.14.0",
    "pinyin-pro": "^3.28.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "npmRebuild": false,
    "appId": "Yunofactory.ProjectCarminium.Player",
    "productName": "Project Carminium",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "build/icon.png",
      "version.json",
      "package.json",
      "!electron/bin/linux/**/*",
      "!electron/bin/win32/**/*",
      "!electron/bin/carminium_audio.so",
      "!electron/bin/carminium_audio.dll",
      "!electron/bin/ffmpeg",
      "!electron/bin/ffprobe",
      "!electron/bin/ffmpeg.exe",
      "!electron/bin/ffprobe.exe"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "files": [
        "electron/bin/win32/**/*",
        "electron/bin/carminium_audio.dll",
        "electron/bin/ffmpeg.exe",
        "electron/bin/ffprobe.exe"
      ],
      "asarUnpack": [
        "node_modules/better-sqlite3/**/*",
        "node_modules/koffi/**/*",
        "node_modules/@koromix/koffi-win32-x64/**/*",
        "node_modules/sharp/**/*",
        "node_modules/@img/sharp-win32-x64/**/*",
        "electron/bin/win32/**/*",
        "electron/bin/carminium_audio.dll",
        "electron/bin/ffmpeg.exe",
        "electron/bin/ffprobe.exe"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio;Music;Player;AudioVideo",
      "vendor": "Yunofactory",
      "synopsis": "Carminium — マテリアルデザイン音楽プレイヤー",
      "description": "マテリアルデザイン（M3）に準拠した高機能デスクトップ音楽プレイヤー。ローカルと Subsonic の両方に対応。",
      "files": [
        "electron/bin/linux/**/*",
        "electron/bin/carminium_audio.so",
        "electron/bin/ffmpeg",
        "electron/bin/ffprobe"
      ],
      "asarUnpack": [
        "node_modules/better-sqlite3/**/*",
        "node_modules/koffi/**/*",
        "node_modules/@koromix/koffi-linux-x64/**/*",
        "node_modules/sharp/**/*",
        "node_modules/@img/sharp-linux-x64-gnu/**/*",
        "node_modules/@img/sharp-linux-x64-musl/**/*",
        "electron/bin/linux/**/*",
        "electron/bin/carminium_audio.so",
        "electron/bin/ffmpeg",
        "electron/bin/ffprobe"
      ]
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-amd64.deb",
      "compression": "xz",
      "depends": [
        "libasound2",
        "libpulse0",
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1"
      ],
      "priority": "optional",
      "packageCategory": "sound"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-x86_64.AppImage"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/sharp-win32-x64/**/*",
      "node_modules/@img/sharp-linux-x64-gnu/**/*",
      "node_modules/@img/sharp-linux-x64-musl/**/*",
      "electron/bin/**/*"
    ]
  }
}
