{
  "name": "Carminium",
  "version": "0.6.3-1.20260808",
  "description": "Carminium",
  "main": "electron/main.js",
  "author": {
    "name": "Seirai Haraguchi",
    "email": "chihuyou90@gmail.com"
  },
  "homepage": "https://gitlab.com/Seirai-Haraguchi/carminium/",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "node scripts/start-electron.js .",
    "dev": "node scripts/start-electron.js . --dev",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "install:win": "npm install && npm run rebuild",
    "build:native": "cd native && zig build copy -Doptimize=ReleaseFast",
    "build": "node scripts/sync-version.js && electron-builder --win",
    "build:dir": "node scripts/sync-version.js && electron-builder --win --dir",
    "build:portable": "node scripts/sync-version.js && electron-builder --win portable",
    "build:all": "npm run build:native && npm run rebuild && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "gsap": "3.15.0",
    "koffi": "^3.1.4",
    "music-metadata": "^11.14.0",
    "pinyin-pro": "^3.28.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "npmRebuild": false,
    "appId": "Yunofactory.ProjectCarminium.Player",
    "productName": "Project Carminium",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "build/icon.png",
      "version.json",
      "package.json",
      "!electron/bin/linux/**/*",
      "!electron/bin/win32/**/*",
      "!electron/bin/carminium_audio.so",
      "!electron/bin/carminium_audio.dll",
      "!electron/bin/ffmpeg",
      "!electron/bin/ffprobe",
      "!electron/bin/ffmpeg.exe",
      "!electron/bin/ffprobe.exe"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "files": [
        "electron/bin/win32/**/*",
        "electron/bin/carminium_audio.dll",
        "electron/bin/ffmpeg.exe",
        "electron/bin/ffprobe.exe"
      ],
      "asarUnpack": [
        "node_modules/better-sqlite3/**/*",
        "node_modules/koffi/**/*",
        "node_modules/@koromix/koffi-win32-x64/**/*",
        "node_modules/sharp/**/*",
        "node_modules/@img/sharp-win32-x64/**/*",
        "electron/bin/win32/**/*",
        "electron/bin/carminium_audio.dll",
        "electron/bin/ffmpeg.exe",
        "electron/bin/ffprobe.exe"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/sharp-win32-x64/**/*",
      "electron/bin/**/*"
    ]
  }
}
